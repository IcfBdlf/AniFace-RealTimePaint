{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AniFace 在线运行",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/canvas_stream.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "AniFace 离线运行",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/canvas_stream.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONIOENCODING": "utf-8",
                "HF_HUB_OFFLINE": "1"
            }
        }
    ]
}
